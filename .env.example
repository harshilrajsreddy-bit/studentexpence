# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="student-spendsense-secure-jwt-secret-key-2026"

# Optional: Supabase credentials for direct Supabase cloud hosting.
# When provided, transactions and auth can sync directly with Supabase PostgreSQL.
# In local development without Supabase credentials, Student SpendSense uses its
# built-in zero-config persistent SQLite/JSON database engine with identical schema and full user isolation.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
